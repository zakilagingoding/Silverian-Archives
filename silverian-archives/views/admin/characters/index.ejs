<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Manage Characters - Silverian Archives</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <style>
        body { background-color: #0b0f19; color: #e2e8f0; }
        
        /* CSS Murni Tanpa Campur Tangan Bootstrap Table */
        .dark-table-container { width: 100%; border-collapse: separate; border-spacing: 0 12px; }
        .dark-table-container th { 
            color: #c5a059; font-family: 'Cinzel', serif; letter-spacing: 1px; text-transform: uppercase;
            padding: 10px 15px; border-bottom: 2px solid #3a4b70; font-weight: bold; text-align: left;
        }
        .dark-table-container td { 
            background-color: #0f172a; /* Warna gelap elegan */
            color: #f8fafc; /* Warna font terang */
            padding: 15px; vertical-align: middle; 
            border-top: 1px solid #1e293b; border-bottom: 1px solid #1e293b;
        }
        /* Melengkungkan sudut baris */
        .dark-table-container td:first-child { border-left: 1px solid #1e293b; border-top-left-radius: 10px; border-bottom-left-radius: 10px; }
        .dark-table-container td:last-child { border-right: 1px solid #1e293b; border-top-right-radius: 10px; border-bottom-right-radius: 10px; }
        .dark-table-container tr:hover td { background-color: #1e293b; transition: 0.3s; }
        
        .btn-gold { background: linear-gradient(135deg, #c5a059, #dfb96e); color: #000; font-weight: bold; border: none; }
        .table-img { width: 65px; height: 65px; object-fit: cover; object-position: top center; border-radius: 50%; border: 2px solid #3a4b70; background: #0b0f19; }
    </style>
</head>
<body class="pt-5 pb-5">
    <div class="container">
        
        <div class="d-flex justify-content-between align-items-center mb-4 border-bottom border-secondary pb-3">
            <h2 style="font-family: 'Cinzel', serif; color: #c5a059; letter-spacing: 1px; text-transform: uppercase;">Character Archives</h2>
            <div>
                <a href="/admin/dashboard" class="btn btn-outline-light me-2 rounded-pill px-4">Back to Dashboard</a>
                <a href="/admin/characters/create" class="btn btn-gold rounded-pill px-4">+ Add New Character</a>
            </div>
        </div>

        <form action="/admin/characters" method="GET" class="mb-4 d-flex">
            <input type="text" name="search" class="form-control me-2" placeholder="Cari nama atau elemen..." style="background-color: #0f172a; color: #fff; border: 1px solid #3a4b70; border-radius: 8px;">
            <button type="submit" class="btn btn-gold rounded-3 px-4">Search</button>
        </form>

        <!-- Hapus class "table-responsive" agar tidak ada scrollbar bawah -->
        <table class="dark-table-container">
            <thead>
                <tr>
                    <th width="90" class="text-center">Image</th>
                    <th width="200">Name</th>
                    <th width="150">Element</th>
                    <th>Description</th>
                    <th width="180" class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                <% if(locals.characters && characters.length > 0) { %>
                    <% characters.forEach(function(char) { %>
                        <tr>
                            <td class="text-center">
                                <% if(char.image_url) { %>
                                    <img src="<%= char.image_url %>" class="table-img" alt="<%= char.name %>">
                                <% } else { %>
                                    <div class="table-img d-flex align-items-center justify-content-center text-muted" style="font-size: 0.6rem;">No Img</div>
                                <% } %>
                            </td>
                            <td class="fw-bold fs-5"><%= char.name %></td>
                            <td><span class="badge px-3 py-2 rounded-pill" style="background-color: #0b0f19; border: 1px solid #475569; color:#cbd5e1;"><%= char.element %></span></td>
                            <td style="color: #94a3b8; font-size: 0.95rem;">
                                <%= char.description ? String(char.description).substring(0, 70) + '...' : '-' %>
                            </td>
                            <td>
                                <div class="d-flex justify-content-center gap-2">
                                    <a href="/admin/characters/edit/<%= char.id %>" class="btn btn-sm px-3 rounded-pill fw-bold" style="background-color: #1e293b; color: #c5a059; border: 1px solid #3a4b70;">Edit</a>
                                    <form action="/admin/characters/delete/<%= char.id %>" method="POST" onsubmit="return confirm('Hapus karakter ini dari arsip?');">
                                        <button type="submit" class="btn btn-sm px-3 rounded-pill fw-bold" style="background-color: #7f1d1d; color: #fca5a5; border: 1px solid #dc2626;">Delete</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    <% }) %>
                <% } else { %>
                    <tr>
                        <td colspan="5" class="text-center py-5 text-muted">Tidak ada karakter ditemukan.</td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>
</body>
</html>