<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Edit Tier - Silverian Archives</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="pt-5">
    <div class="container" style="max-width: 600px;">
        <h2 class="mb-4" style="font-family: 'Cinzel', serif; color: #c5a059;">Edit Tier Details</h2>
        <% if(errors.length > 0) { %>
            <div class="alert alert-danger" style="background-color: rgba(127,29,29,0.2); border-color: #7f1d1d; color: #fca5a5;">
                <ul class="mb-0"><% errors.forEach(err => { %> <li><%= err.msg %></li> <% }) %></ul>
            </div>
        <% } %>
        <div class="card p-4" style="background-color: rgba(20,27,45,0.85); border: 1px solid #3a4b70;">
            <form action="/admin/tiers/edit/<%= tier.id %>" method="POST">
                <div class="mb-3">
                    <label class="form-label text-light">Tier Rank</label>
                    <input type="text" name="name" class="form-control" style="background-color: #0f172a; color:#fff; border: 1px solid #3a4b70;" value="<%= tier.name %>">
                </div>
                <div class="mb-4">
                    <label class="form-label text-light">Alasan / Kriteria Tier</label>
                    <textarea name="description" class="form-control" rows="3" style="background-color: #0f172a; color:#fff; border: 1px solid #3a4b70;"><%= tier.description %></textarea>
                </div>
                <button type="submit" class="btn w-100" style="background-color: #c5a059; color: #000; font-weight: bold;">Update Tier</button>
                <a href="/admin/tiers" class="btn btn-outline-light w-100 mt-2">Cancel</a>
            </form>
        </div>
    </div>
</body>
</html>