<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Manage Game Mechanics - Silverian Archives</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background-color: #0b0f19; color: #e2e8f0; }
        
        .dark-table-container { width: 100%; border-collapse: separate; border-spacing: 0 12px; }
        .dark-table-container th { 
            color: #c5a059; font-family: 'Cinzel', serif; letter-spacing: 1px; text-transform: uppercase;
            padding: 10px 15px; border-bottom: 2px solid #3a4b70; font-weight: bold; text-align: left;
        }
        .dark-table-container td { 
            background-color: #0f172a; color: #f8fafc; 
            padding: 15px; vertical-align: middle; 
            border-top: 1px solid #1e293b; border-bottom: 1px solid #1e293b;
        }
        .dark-table-container td:first-child { border-left: 1px solid #1e293b; border-top-left-radius: 10px; border-bottom-left-radius: 10px; }
        .dark-table-container td:last-child { border-right: 1px solid #1e293b; border-top-right-radius: 10px; border-bottom-right-radius: 10px; }
        .dark-table-container tr:hover td { background-color: #1e293b; transition: 0.3s; }
        
        .btn-gold { background: linear-gradient(135deg, #c5a059, #dfb96e); color: #000; font-weight: bold; border: none; }
        .btn-gold:hover { transform: scale(1.03); }
        .table-banner { height: 50px; width: 90px; object-fit: cover; border-radius: 6px; border: 1px solid #3a4b70; }
    </style>
</head>
<body class="pt-5 pb-5">
    <div class="container">
        
        <div class="d-flex justify-content-between align-items-center mb-4 border-bottom border-secondary pb-3">
            <h2 style="font-family: 'Cinzel', serif; color: #c5a059; letter-spacing: 1px; text-transform: uppercase;">Game Mechanics & Guides</h2>
            <div>
                <a href="/admin/dashboard" class="btn btn-outline-light me-2 rounded-pill px-4">Back to Dashboard</a>
                <a href="/admin/mechanics/create" class="btn btn-gold rounded-pill px-4">+ Add New Guide</a>
            </div>
        </div>

        <% let searchVal = typeof search !== 'undefined' ? search : ''; %>
        <form action="/admin/mechanics" method="GET" class="mb-4 d-flex">
            <input type="text" name="search" class="form-control me-2" placeholder="Cari judul panduan..." value="<%= searchVal %>" style="background-color: #0f172a; color: #fff; border: 1px solid #3a4b70; border-radius: 8px;">
            <button type="submit" class="btn btn-gold rounded-3 px-4">Search</button>
        </form>

        <table class="dark-table-container">
            <thead>
                <tr>
                    <th width="120">Thumbnail</th>
                    <th>Title</th>
                    <th width="150" class="text-center">Video Tutorial</th>
                    <th width="150">Author</th>
                    <th width="180" class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                <% if(typeof mechanics !== 'undefined' && mechanics.length > 0) { %>
                    <% mechanics.forEach(function(mech) { %>
                        <tr>
                            <td>
                                <% if(mech.thumbnail_url) { %>
                                    <img src="<%= mech.thumbnail_url %>" class="table-banner" alt="Thumbnail">
                                <% } else { %>
                                    <div class="table-banner bg-dark d-flex align-items-center justify-content-center text-muted" style="font-size: 0.7rem;">No Image</div>
                                <% } %>
                            </td>
                            <td class="fw-bold fs-5"><%= mech.title %></td>
                            <td class="text-center">
                                <% if(mech.video_url) { %>
                                    <span class="badge bg-success rounded-pill px-3">Available</span>
                                <% } else { %>
                                    <span class="badge bg-secondary rounded-pill px-3">No Video</span>
                                <% } %>
                            </td>
                            <td style="color: #cbd5e1;"><%= mech.author_name ? mech.author_name : 'admin' %></td>
                            <td>
                                <div class="d-flex justify-content-center gap-2">
                                    <a href="/admin/mechanics/edit/<%= mech.id %>" class="btn btn-sm px-3 rounded-pill fw-bold" style="background-color: #1e293b; color: #c5a059; border: 1px solid #3a4b70;">Edit</a>
                                    <form action="/admin/mechanics/delete/<%= mech.id %>" method="POST" onsubmit="return confirm('Hapus panduan ini?');">
                                        <button type="submit" class="btn btn-sm px-3 rounded-pill fw-bold" style="background-color: #7f1d1d; color: #fca5a5; border: 1px solid #dc2626;">Delete</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    <% }) %>
                <% } else { %>
                    <tr><td colspan="5" class="text-center py-5 text-muted">Belum ada panduan mekanik yang tersedia.</td></tr>
                <% } %>
            </tbody>
        </table>

        <!-- Pagination (Safe Logic) -->
        <% if(typeof totalPages !== 'undefined' && totalPages > 1) { %>
            <nav class="mt-4">
                <ul class="pagination justify-content-center">
                    <% for(let i = 1; i <= totalPages; i++) { %>
                        <% if (typeof page !== 'undefined' && page === i) { %>
                            <li class="page-item active"><a class="page-link shadow-sm" href="?page=<%= i %>&search=<%= searchVal %>" style="background-color: #c5a059; border-color: #c5a059; color:#000; font-weight:bold;"><%= i %></a></li>
                        <% } else { %>
                            <li class="page-item"><a class="page-link shadow-sm" href="?page=<%= i %>&search=<%= searchVal %>" style="background-color: #0f172a; border-color: #3a4b70; color: #c5a059;"><%= i %></a></li>
                        <% } %>
                    <% } %>
                </ul>
            </nav>
        <% } %>
    </div>
</body>
</html>