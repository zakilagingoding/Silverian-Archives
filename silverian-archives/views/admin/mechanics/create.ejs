<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Add Guide - Silverian Archives</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="pt-5">
    <div class="container" style="max-width: 800px;">
        <h2 class="mb-4" style="font-family: 'Cinzel', serif; color: #c5a059;">Create Game Mechanics Guide</h2>
        
        <% if(errors.length > 0) { %>
            <div class="alert alert-danger" style="background-color: rgba(127,29,29,0.2); border-color: #7f1d1d; color: #fca5a5;">
                <ul class="mb-0">
                    <% errors.forEach(err => { %> <li><%= err.msg %></li> <% }) %>
                </ul>
            </div>
        <% } %>

        <div class="card p-4" style="background-color: rgba(20,27,45,0.85); border: 1px solid #3a4b70;">
            <form action="/admin/mechanics/create" method="POST" enctype="multipart/form-data">
                <div class="mb-3">
                    <label class="form-label text-light">Guide Title</label>
                    <input type="text" name="title" class="form-control" style="background-color: #0f172a; color:#fff; border: 1px solid #3a4b70;" value="<%= formData.title || '' %>">
                </div>
                
                <div class="mb-3">
                    <label class="form-label text-light">YouTube Video URL</label>
                    <input type="text" name="youtube_url" class="form-control" placeholder="https://www.youtube.com/watch?v=..." style="background-color: #0f172a; color:#fff; border: 1px solid #3a4b70;" value="<%= formData.youtube_url || '' %>">
                    <small class="text-muted">Masukkan link YouTube biasa, sistem akan merubahnya menjadi pemutar video di web.</small>
                </div>

                <div class="mb-3">
                    <label class="form-label text-light">Main Tutorial</label>
                    <textarea name="content" class="form-control" rows="6" style="background-color: #0f172a; color:#fff; border: 1px solid #3a4b70;"><%= formData.content || '' %></textarea>
                </div>

                <div class="mb-3">
                    <label class="form-label text-light">Pro Tips (Optional)</label>
                    <textarea name="tips" class="form-control" rows="3" style="background-color: #0f172a; color:#fff; border: 1px solid #3a4b70;"><%= formData.tips || '' %></textarea>
                </div>

                <div class="mb-3">
                    <label class="form-label text-light">FAQ - Frequently Asked Questions (Optional)</label>
                    <textarea name="faq" class="form-control" rows="4" placeholder="Q: Bagaimana caranya...? &#10;A: Anda bisa menggunakan..." style="background-color: #0f172a; color:#fff; border: 1px solid #3a4b70;"><%= formData.faq || '' %></textarea>
                </div>

                <div class="mb-4">
                    <label class="form-label text-light">Guide Thumbnail (Image)</label>
                    <input type="file" name="thumbnail" class="form-control" style="background-color: #0f172a; color:#fff; border: 1px solid #3a4b70;" accept="image/*">
                </div>

                <button type="submit" class="btn w-100" style="background-color: #c5a059; color: #000; font-weight: bold; font-family: 'Cinzel', serif;">Publish Guide</button>
                <a href="/admin/mechanics" class="btn btn-outline-light w-100 mt-2">Cancel</a>
            </form>
        </div>
    </div>
</body>
</html>