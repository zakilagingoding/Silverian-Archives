<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Edit Guide - Silverian Archives</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="pt-5">
    <div class="container" style="max-width: 800px;">
        <h2 class="mb-4" style="font-family: 'Cinzel', serif; color: #c5a059;">Edit Mechanics Guide</h2>
        
        <% if(errors.length > 0) { %>
            <div class="alert alert-danger" style="background-color: rgba(127,29,29,0.2); border-color: #7f1d1d; color: #fca5a5;">
                <ul class="mb-0">
                    <% errors.forEach(err => { %> <li><%= err.msg %></li> <% }) %>
                </ul>
            </div>
        <% } %>

        <div class="card p-4" style="background-color: rgba(20,27,45,0.85); border: 1px solid #3a4b70;">
            <form action="/admin/mechanics/edit/<%= mechanic.id %>" method="POST" enctype="multipart/form-data">
                <div class="mb-3">
                    <label class="form-label text-light">Guide Title</label>
                    <input type="text" name="title" class="form-control" style="background-color: #0f172a; color:#fff; border: 1px solid #3a4b70;" value="<%= mechanic.title %>">
                </div>

                <div class="mb-3">
                    <label class="form-label text-light">YouTube Video URL</label>
                    <input type="text" name="youtube_url" class="form-control" style="background-color: #0f172a; color:#fff; border: 1px solid #3a4b70;" value="<%= mechanic.youtube_url %>">
                    <% if (mechanic.youtube_url) { %>
                        <div class="mt-2">
                            <iframe width="100%" height="200" src="<%= mechanic.youtube_url %>" frameborder="0" allowfullscreen class="rounded border border-secondary"></iframe>
                        </div>
                    <% } %>
                </div>

                <div class="mb-3">
                    <label class="form-label text-light">Main Tutorial</label>
                    <textarea name="content" class="form-control" rows="6" style="background-color: #0f172a; color:#fff; border: 1px solid #3a4b70;"><%= mechanic.content %></textarea>
                </div>

                <div class="mb-3">
                    <label class="form-label text-light">Pro Tips</label>
                    <textarea name="tips" class="form-control" rows="3" style="background-color: #0f172a; color:#fff; border: 1px solid #3a4b70;"><%= mechanic.tips %></textarea>
                </div>

                <div class="mb-3">
                    <label class="form-label text-light">FAQ</label>
                    <textarea name="faq" class="form-control" rows="4" style="background-color: #0f172a; color:#fff; border: 1px solid #3a4b70;"><%= mechanic.faq %></textarea>
                </div>

                <div class="mb-4">
                    <label class="form-label text-light d-block">Guide Thumbnail</label>
                    <% if(mechanic.thumbnail_url) { %>
                        <img src="<%= mechanic.thumbnail_url %>" width="150" class="mb-3 rounded border border-secondary">
                    <% } %>
                    <input type="file" name="thumbnail" class="form-control" style="background-color: #0f172a; color:#fff; border: 1px solid #3a4b70;" accept="image/*">
                    <small class="text-muted">Biarkan kosong jika tidak ingin mengubah thumbnail.</small>
                </div>

                <button type="submit" class="btn w-100" style="background-color: #c5a059; color: #000; font-weight: bold; font-family: 'Cinzel', serif;">Update Guide</button>
                <a href="/admin/mechanics" class="btn btn-outline-light w-100 mt-2">Cancel</a>
            </form>
        </div>
    </div>
</body>
</html>