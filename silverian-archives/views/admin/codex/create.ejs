<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Add Lore - Silverian Archives</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="pt-5">
    <div class="container" style="max-width: 800px;">
        <h2 class="mb-4" style="font-family: 'Cinzel', serif; color: #c5a059;">Record New Lore</h2>
        
        <% if(errors.length > 0) { %>
            <div class="alert alert-danger" style="background-color: rgba(127,29,29,0.2); border-color: #7f1d1d; color: #fca5a5;">
                <ul class="mb-0">
                    <% errors.forEach(err => { %> <li><%= err.msg %></li> <% }) %>
                </ul>
            </div>
        <% } %>

        <div class="card p-4" style="background-color: rgba(20,27,45,0.85); border: 1px solid #3a4b70;">
            <form action="/admin/codex/create" method="POST" enctype="multipart/form-data">
                <div class="mb-3">
                    <label class="form-label text-light">Lore Title</label>
                    <input type="text" name="title" class="form-control" style="background-color: #0f172a; color:#fff; border: 1px solid #3a4b70;" value="<%= formData.title || '' %>">
                </div>
                <div class="mb-3">
                    <label class="form-label text-light">Category / Faction</label>
                    <select name="category_id" class="form-control" style="background-color: #0f172a; color:#fff; border: 1px solid #3a4b70;">
                        <option value="">-- Pilih Kategori --</option>
                        <% categories.forEach(cat => { %>
                            <option value="<%= cat.id %>" <%= formData.category_id == cat.id ? 'selected' : '' %>><%= cat.name %></option>
                        <% }) %>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label text-light">Lore Content</label>
                    <textarea name="content" class="form-control" rows="8" style="background-color: #0f172a; color:#fff; border: 1px solid #3a4b70;"><%= formData.content || '' %></textarea>
                </div>
                <div class="mb-4">
                    <label class="form-label text-light">Banner Image</label>
                    <input type="file" name="image" class="form-control" style="background-color: #0f172a; color:#fff; border: 1px solid #3a4b70;" accept="image/*">
                </div>
                <button type="submit" class="btn w-100" style="background-color: #c5a059; color: #000; font-weight: bold; font-family: 'Cinzel', serif;">Save Lore to Archives</button>
                <a href="/admin/codex" class="btn btn-outline-light w-100 mt-2">Cancel</a>
            </form>
        </div>
    </div>
</body>
</html>