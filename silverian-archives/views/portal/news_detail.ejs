<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title><%= news.title %> - Silverian Archives</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="pt-5 pb-5" style="background:#0b0f19;">
    <div class="container mb-4">
        <a href="/" class="btn btn-outline-light btn-sm">&larr; Back to Portal</a>
    </div>

    <div class="container" style="max-width: 800px;">
        <div class="card p-4 shadow-lg" style="background-color: rgba(20,27,45,0.6); border: 1px solid #3a4b70;">
            <% if(news.banner_url) { %>
                <img src="<%= news.banner_url %>" class="img-fluid rounded border border-secondary mb-4" style="max-height: 400px; object-fit: cover; width: 100%;">
            <% } %>
            
            <h1 style="font-family: 'Cinzel', serif; color: #c5a059;"><%= news.title %></h1>
            <p class="text-warning fw-bold border-bottom border-secondary pb-3 mb-4"><%= new Date(news.created_at).toLocaleDateString() %></p>
            
            <div style="color: #cbd5e1; white-space: pre-wrap; font-size: 1.1rem; line-height: 1.8;"><%= news.content %></div>
        </div>
    </div>
</body>
</html>